[Desktop Entry]
Type=Application
Version=1.5
Name=AppDeb
GenericName=Application Manager
Comment=Install and manage Flatpak, Snap, Homebrew, AppImage, .deb and .tar.gz applications
Exec=appdeb %F
Icon=io.github.ta4anx.AppDeb
Terminal=false
Categories=System;PackageManager;
Keywords=package;installer;flatpak;appimage;deb;app;brew;snap;
MimeType=application/vnd.appimage;application/x-compressed-tar;application/gzip;application/vnd.debian.binary-package;application/vnd.flatpak;application/vnd.flatpak.ref;
StartupNotify=true
StartupWMClass=io.github.ta4anx.AppDeb
